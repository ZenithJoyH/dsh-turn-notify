{
  "name": "dsh-turn-notify",
  "version": "0.1.0",
  "description": "DSH turn-completion notifications with per-turn freshness checks and non-blocking in-page fallback.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@deepseek-ai/dsh-client-runtime"], "platform": "web" }
  },
  "license": "MIT",
  "engines": { "node": ">=22" }
}
